{
  "name": "glentify",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:mobile": "bash scripts/build-mobile.sh",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- tsx scripts/migrate.ts",
    "db:smoke": "dotenv -e .env.local -- tsx scripts/smoke-schema.ts",
    "db:seed:axis-types": "dotenv -e .env.local -- tsx scripts/seed-axis-types.ts",
    "db:migrate-to-multiuser": "dotenv -e .env.local -- tsx scripts/migrate-to-multiuser.ts",
    "db:migrate:finalize": "dotenv -e .env.local -- tsx scripts/migrate-finalize.ts"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.7.0",
    "dejavu-fonts-ttf": "^2.37.3",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.12",
    "pdfkit": "^0.20.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-swipeable": "^7.0.2",
    "resend": "^6.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "daisyui": "^5.7.9",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
