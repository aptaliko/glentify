# Local development env — copy to .env.local (`npm run dev:up` does this for you on first run).
#
# This points the app at the LOCAL Docker stack (Postgres + neon-http proxy), NOT prod.
# Production values live only in Vercel's env settings — never put the prod DATABASE_URL here.

# Turns on the local-proxy redirect in src/db/neonConfig.ts. Without this the app would try
# to reach Neon's cloud. Leave it set to 1 for local dev.
NEON_LOCAL=1

# The local Postgres from docker-compose.yml. The neon-http driver never opens this socket
# directly — it fetches the proxy on :4444 — but the URL still carries the db name/credentials.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/glentify

# Any random string is fine locally.
AUTH_SECRET=local-dev-secret-change-me

# Optional locally (see README): unset RESEND_* just skips sending reset emails; unset
# BLOB_READ_WRITE_TOKEN only disables sheet-music photo upload. Everything else works.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# BLOB_READ_WRITE_TOKEN=
