#!/usr/bin/env bash
# Local mirror of .github/workflows/ci.yml — catches a red check before it reaches GitHub
# (or, for main, before it triggers a Vercel deploy). Opt-in: activated by `npm run setup:hooks`,
# which points git's core.hooksPath here. Because core.hooksPath is LOCAL config, this hook does
# NOT auto-activate on clone — each checkout runs setup:hooks once.
#
# All four checks are pure/offline and fast (~a few seconds total); none touch the database.
# Bypass in a genuine emergency with `git push --no-verify`.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "pre-push: running CI checks locally (lint, typecheck, test, check:skills)…"
npm run lint
npm run typecheck
npm test
npm run check:skills
echo "pre-push: all checks passed ✓"
